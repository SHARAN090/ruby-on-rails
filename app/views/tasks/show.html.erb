<h1>Task Details</h1>

<h2><%= @task.name %></h2>

<p>
  <strong>Description:</strong>
  <%= @task.description %>
</p>

<p>
  <strong>Due Date:</strong>
  <%= @task.due_date %>
</p>

<p>
  <strong>Priority:</strong>
  <%= @task.priority %>
</p>

<p>
  <strong>Status:</strong>
  <%= @task.status %>
</p>

<hr>

<%= link_to "Edit Task", edit_task_path(@task) %>

<br><br>

<%= link_to "Back to Tasks", tasks_path %>


<br><br>

<%= button_to "Delete Task",
              task_path(@task),
              method: :delete,
              data: { turbo_confirm: "Are you sure you want to delete this task?" } %>
<br>

